# Chase Wellness Marketing Automation - Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# OPENAI API (Required for content generation)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# TWITTER/X API (Required for publishing to X)
# ============================================
# Get these from: https://developer.twitter.com/en/portal/dashboard
# 1. Create a project and app
# 2. Enable OAuth 1.0a with read+write permissions
# 3. Generate API keys and access tokens

TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_ACCESS_SECRET=your-access-token-secret
TWITTER_USERNAME=ChaseWellnessRD

# ============================================
# INSTAGRAM API (Required for publishing to Instagram)
# ============================================
# Requirements:
# 1. Instagram Business or Creator account
# 2. Connected to a Facebook Page
# 3. Facebook App with Instagram Graph API

# Get these from Facebook Developer Console:
# https://developers.facebook.com/

INSTAGRAM_ACCESS_TOKEN=your-long-lived-access-token
INSTAGRAM_BUSINESS_ID=your-instagram-business-account-id

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Base URL for the app (used for callbacks, etc.)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
